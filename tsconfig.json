{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": true,
    "types": ["node"],
    "typeRoots": ["./typings", "./node_modules/@types"]
  },
  "include": [
    "dsh/index.ts",
    "dsh/client.ts",
    "dsh/web/app.ts",
    "typings/**/*.d.ts",
    "tests/*.ts",
    "tests/e2e/*.ts"
  ]
}
